@inject IHttpContextAccessor ContextAccessor
@inject IJSRuntime JSRuntime
@inject ILogger<NavMenu> Logger

<div class="nav-wrapper">
    <input type="checkbox" id="nav-toggle" class="nav-toggle" @bind="isCollapsed" @bind:after="SaveCollapsedAsync" />
    <div class="nav-sidebar">
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand nav-text" href="">VsInsertions</a>
                <label class="navbar-toggler" for="nav-toggle" role="button" aria-label="Toggle navigation">
                    <span class="chevron-icon"></span>
                </label>
            </div>
        </div>

        <div class="nav-scrollable">
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                        <span class="nav-text">Insertions</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="flows">
                        <span class="bi bi-diagram-3-nav-menu" aria-hidden="true"></span>
                        <span class="nav-text">Flows</span>
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>
</div>

@code {
    private bool isCollapsed;

    protected override void OnInitialized() =>
        isCollapsed = ContextAccessor.HttpContext?.Request.Cookies["nav-collapsed"] == "1";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isCollapsed = await JSRuntime.InvokeAsync<string?>("getCookie", "nav-collapsed") == "1";
                StateHasChanged();
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "Failed to read the navigation collapsed state");
            }
        }
    }

    private async Task SaveCollapsedAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("setCookie", "nav-collapsed", isCollapsed ? "1" : "0");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Failed to save the navigation collapsed state");
        }
    }
}
